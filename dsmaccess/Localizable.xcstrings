    "share_permissions.folders.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between an account's own right and those of its groups: a no-access denial wins over everything, otherwise the widest right applies. An account set to read/write inside a read-only group can therefore write."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre le droit du compte et celui de ses groupes : un aucun accès l’emporte sur tout, sinon c’est le droit le plus large qui s’applique. Un compte en lecture/écriture dans un groupe en lecture seule peut donc écrire."
          }
        }
      }
    },
    "share_permissions.folders.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This NAS exposes no shared folder to grant access to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce NAS n’expose aucun dossier partagé à autoriser."
          }
        }
      }
    },
