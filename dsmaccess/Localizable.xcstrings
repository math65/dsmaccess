    "external_devices.settings.forbid_usb.confirm.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbid the USB Port"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdire le port USB"
          }
        }
      }
    },
    "external_devices.settings.forbid_usb.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every USB device will be blocked, including those already connected. The NAS must be restarted for this to take effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les périphériques USB seront bloqués, y compris ceux déjà connectés. Le NAS doit redémarrer pour que ce réglage prenne effet."
          }
        }
      }
    },
    "external_devices.settings.forbid_usb.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbid the USB port?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdire le port USB ?"
          }
        }
      }
    },
    "external_devices.settings.forbid_usb.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbidding the USB port blocks every kind of USB device. The NAS must be restarted for this to take effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interdiction du port USB bloque tous les types de périphériques USB. Le NAS doit redémarrer pour que ce réglage prenne effet."
          }
        }
      }
    },
    "external_devices.settings.forbid_usb.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block every USB device on the NAS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer tous les périphériques USB du NAS"
          }
        }
      }
    },
    "external_devices.settings.forbid_usb.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbid the use of the USB port"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdire l’utilisation du port USB"
          }
        }
      }
    },
    "external_devices.settings.non_admin_eject.hint": {
