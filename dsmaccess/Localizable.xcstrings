    "root.decoding_failure.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed: DSM Access could not read what %@ replied. Reporting sends the call involved and the names of the fields received, never their contents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération a échoué : DSM Access n’a pas su lire ce que %@ a répondu. Signaler transmet l’appel concerné et les noms des champs reçus, jamais leur contenu."
          }
        }
      }
    },
    "root.decoding_failure.report.button": {
      "localizations": {
        "en": {
