    "packages.update.confirm.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” will be updated to version %2$@. The package will be downloaded, installed, and restarted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera mis à jour vers la version %@. Le paquet sera téléchargé, installé puis redémarré."
          }
