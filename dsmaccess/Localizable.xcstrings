    "external_devices.filesystem.cross_platform.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 and EXFAT are read by macOS and Windows as well as by the NAS. FAT32 cannot hold a file larger than 4 GB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 et EXFAT sont lus par macOS et Windows autant que par le NAS. FAT32 ne peut pas contenir de fichier de plus de 4 Go."
          }
        }
      }
    },
    "external_devices.filesystem.ext4.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EXT4 is the Linux file system. A drive formatted this way is read by the NAS, but not by macOS or Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EXT4 est le système de fichiers de Linux. Un disque formaté ainsi est lu par le NAS, mais pas par macOS ni Windows."
          }
        }
      }
    },
