    "share_permissions.table.group_right.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A denial set on a group applies to every member and cannot be lifted account by account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un refus accordé à un groupe s’applique à tous ses membres et ne peut pas être levé compte par compte."
