    "announcements.settings.queue.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads every announcement in order without interrupting the previous announcement"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit toutes les annonces dans l’ordre sans interrompre l’annonce précédente"
          }
        }
      }
    },
    "announcements.settings.queue.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, rapid announcements such as “loading” followed by “complete” are all read in order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, les annonces rapides comme « chargement » puis « terminé » sont toutes lues dans l’ordre."
          }
        }
      }
    },
    "announcements.settings.sound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a sound when an operation finishes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer un son à la fin d’une opération"
          }
        }
