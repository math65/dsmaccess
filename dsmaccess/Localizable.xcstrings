    "monitor.history.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The NAS has recorded no alert since history recording was turned on. An alert appears here when a resource crosses a threshold set in the performance alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le NAS n’a consigné aucune alerte depuis l’activation de l’enregistrement. Une alerte y apparaît quand une ressource franchit un seuil défini dans l’alarme des performances."
          }
        }
      }
    },
    "monitor.history.empty.no_rule.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is on, but no rule is defined in the performance alarm: the NAS has no threshold to watch and will record nothing. This journal stays empty as long as no rule exists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement est actif, mais aucune règle n’est définie dans l’alarme des performances : le NAS n’a aucun seuil à surveiller et ne consignera rien. Ce journal restera vide tant qu’aucune règle n’existe."
          }
        }
      }
    },
    "monitor.history.empty.no_rule.status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
