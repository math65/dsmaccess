    "external_devices.settings.delayed_allocation.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delayed allocation can improve write performance, but it can also lose data during a power cut or if devices are unplugged without being ejected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’allocation retardée peut améliorer les performances en écriture, mais elle peut aussi provoquer une perte de données en cas de coupure de courant ou si les périphériques sont débranchés sans être éjectés."
          }
        }
      }
    },
    "external_devices.settings.delayed_allocation.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve write speed on ext4 drives"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorer la vitesse d’écriture des disques ext4"
          }
        }
      }
    },
    "external_devices.settings.delayed_allocation.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable delayed allocation for ext4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l’allocation retardée pour ext4"
          }
        }
      }
    },
