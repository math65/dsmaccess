    "containers.reset.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be recreated from its settings and left stopped. Its writable layer is discarded: anything written inside the container, outside a mounted folder, is lost. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera recréé à partir de ses réglages et laissé arrêté. Sa couche modifiable est jetée : tout ce qui a été écrit dans le conteneur, hors d’un dossier monté, est perdu. C’est irréversible."
          }
        }
      }
    },
