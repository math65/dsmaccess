    "announcements.settings.notify_long_operation.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a system notification when a copy or another long operation finishes while the app is not in front"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une notification système quand une copie ou une autre opération longue se termine alors que l’app n’est pas au premier plan"
          }
        }
      }
    },
    "announcements.settings.notify_long_operation.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An announcement spoken while DSM Access is in the background is not heard. A notification reaches you. macOS asks for your permission the first time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une annonce prononcée pendant que DSM Access est en arrière-plan n’est pas entendue. La notification, elle, vous parvient. macOS demande votre autorisation la première fois."
          }
        }
      }
    },
    "announcements.settings.queue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue announcements"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les annonces en file d’attente"
          }
        }
