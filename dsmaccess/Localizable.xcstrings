      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History recording is turned off on the NAS, so no alert is being recorded. Turn it on below to record the next ones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de l’historique est désactivé sur le NAS : aucune alerte n’y est consignée. Activez-le ci-dessous pour que les prochaines le soient."
          }
        }
      }
